# Reemplaza 'TU_API_KEY_AQUI' con tu API Key real de Nvidia Build y NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY=TU_API_KEY_AQUI
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Configuración de base de datos PostgreSQL con pgvector
DB_HOST=localhost
